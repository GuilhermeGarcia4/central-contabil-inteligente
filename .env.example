# Copie este arquivo para .env e substitua todos os placeholders locais.
# .env é ignorado pelo Git e é carregado somente em Development.
POSTGRES_DB=central_contabil
POSTGRES_USER=central_contabil
POSTGRES_PASSWORD=change-me

# O runtime prefere ConnectionStrings__Default e aceita CONNECTION_STRING como fallback.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=central_contabil;Username=central_contabil;Password=change-me
CONNECTION_STRING=

JWT_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-development-password
ADMIN_RESET_PASSWORD_ON_START=false
FRONTEND_ORIGIN=http://localhost:4200

# OAuth Google (use User Secrets for o segredo real; callback: http://localhost:5042/signin-google)
Authentication__Google__ClientId=your-google-client-id.apps.googleusercontent.com
Authentication__Google__ClientSecret=

# V7 Knowledge / AI. Gemini é temporário em Development; segredos ficam somente no backend.
# Não use dados financeiros reais em testes no free tier. Produção é configurada separadamente.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/

# OpenAI permanece disponível: troque AI_PROVIDER para openai.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1/
AI__EmbeddingDimensions=384
AI__ChunkCharacters=1400
AI__ChunkOverlapCharacters=160
AI__MaxRetrievedDocuments=6
AI__MaxChunks=8
AI__MaxContextCharacters=12000

# Integrações V2. Não há chaves obrigatórias para os provedores públicos abaixo.
Integrations__BrasilApi__BaseUrl=https://brasilapi.com.br/api/
Integrations__CnpjWs__Enabled=false
Integrations__CnpjWs__BaseUrl=https://publica.cnpj.ws/
Integrations__Chamber__Enabled=true
Integrations__Chamber__BaseUrl=https://dadosabertos.camara.leg.br/api/v2/
Integrations__Senate__Enabled=true
Integrations__Senate__BaseUrl=https://legis.senado.leg.br/
Integrations__Cache__CompanyHours=24
Integrations__Cache__NcmHours=168
